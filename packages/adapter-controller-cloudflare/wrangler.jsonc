{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jit-runner-kit-controller",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-25",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CONTROLLER",
        "class_name": "ControllerDurableObject"
      }
    ]
  },
  "exports": {
    "ControllerDurableObject": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "queues": {
    "producers": [
      {
        "binding": "TASK_QUEUE",
        "queue": "jit-runner-kit-tasks"
      }
    ],
    "consumers": [
      {
        "queue": "jit-runner-kit-tasks",
        "dead_letter_queue": "jit-runner-kit-tasks-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5
      }
    ]
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "ALLOWED_REPOSITORIES": "your-github-organization/example",
    "TRUSTED_BRANCHES": "main",
    "TRIGGER_LABEL": "jit-runner",
    "RUN_LABEL_PREFIX": "jit-run-",
    "GITHUB_ORGANIZATION": "your-github-organization",
    "RUNNER_GROUP_ID": "2",
    "TRUSTED_WORKFLOWS": "your-github-organization/example/.github/workflows/ci.yml@refs/heads/main",
    "MAX_RUNNERS": "2",
    "TTL_SECONDS": "10800",
    "PROVISIONING_TIMEOUT_SECONDS": "300",
    "SERVER_TYPE": "cx33",
    "SERVER_LOCATION": "fsn1",
    "SERVER_IMAGE": "ubuntu-24.04",
    "RUNNER_ARCHITECTURE": "x64",
    "PUBLIC_BASE_URL": "https://jit-runner-kit-controller.example.workers.dev"
  }
}
