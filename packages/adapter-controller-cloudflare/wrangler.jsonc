{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jit-runner-kit-controller",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-25",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CONTROLLER",
        "class_name": "ControllerDurableObject"
      }
    ]
  },
  "exports": {
    "ControllerDurableObject": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "queues": {
    "producers": [
      {
        "binding": "TASK_QUEUE",
        "queue": "jit-runner-kit-tasks"
      }
    ],
    "consumers": [
      {
        "queue": "jit-runner-kit-tasks",
        "dead_letter_queue": "jit-runner-kit-tasks-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5
      }
    ]
  },
  "ratelimits": [
    {
      "name": "PUBLIC_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "ALLOWED_REPOSITORIES": "your-github-organization/example",
    "TRUSTED_BRANCHES": "main",
    "TRIGGER_LABEL": "jit-runner",
    "RUN_LABEL_PREFIX": "jit-run-",
    "RUNNER_SCOPE": "repository",
    "TRUSTED_EVENTS": "push,workflow_dispatch",
    "GITHUB_ORGANIZATION": "your-github-organization",
    "RUNNER_GROUP_ID": "2",
    "TRUSTED_WORKFLOWS": "your-github-organization/example/.github/workflows/ci.yml@refs/heads/main",
    "MAX_RUNNERS": "2",
    "COMPUTE_MODE": "hetzner-pool",
    "POOL_ID": "example",
    "POOL_IDLE_SECONDS": "2700",
    "POOL_AGENT_URL": "https://raw.githubusercontent.com/your-github-organization/jit-runner-kit/0123456789012345678901234567890123456789/bin/jit-runner-pool-agent",
    "POOL_AGENT_SHA256": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
    "POOL_RUNNER_IMAGE": "ghcr.io/your-github-organization/jit-runner-kit-runner@sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
    "POOL_DIND_IMAGE": "docker.io/library/docker:27-dind@sha256:aa3df78ecf320f5fafdce71c659f1629e96e9de0968305fe1de670e0ca9176ce",
    "POOL_BOOTSTRAP_SSH_PUBLIC_KEY": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJ7l5EFHZL3IS+N33HkgonD7hi6RCRtjKSo4EHJxKetI jrk-bootstrap-inert",
    "TTL_SECONDS": "10800",
    "PROVISIONING_TIMEOUT_SECONDS": "300",
    "SERVER_TYPE": "cx33",
    "SERVER_LOCATION": "fsn1",
    "SERVER_IMAGE": "ubuntu-24.04",
    "RUNNER_ARCHITECTURE": "x64",
    "PUBLIC_BASE_URL": "https://jit-runner-kit-controller.example.workers.dev"
  }
}
