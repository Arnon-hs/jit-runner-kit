FROM ubuntu:24.04

ARG RUNNER_VERSION
ARG RUNNER_SHA256_X64
ARG RUNNER_SHA256_ARM64
ARG GH_VERSION=2.98.0
ARG GH_SHA256_X64=3b8ac6b30336802fc1a858d7c084e11cdf24ac1a761ca90b68022d7d729208de
ARG GH_SHA256_ARM64=cf689084f3a3618f7eae4a2420d335d74626d65f5e594b9828d125d69f800d86
ARG RUSTUP_VERSION=1.28.2
ARG RUSTUP_SHA256_X64=20a06e644b0d9bd2fbdbfd52d42540bdde820ea7df86e92e533c073da0cdd43c
ARG RUSTUP_SHA256_ARM64=e3853c5a252fca15252d07cb23a1bdd9377a8c6f3efa01531109281ae47f841c
ARG RUSTUP_LICENSE_MIT_SHA256=c9a75f18b9ab2927829a208fc6aa2cf4e63b8420887ba29cdb265d6619ae82d5
ARG RUSTUP_LICENSE_APACHE_SHA256=8173d5c29b4f956d532781d2b86e4e30f83e6b7878dce18c919451d6ba707c90
ARG TARGETARCH

RUN test -n "$RUNNER_VERSION" && test -n "$RUNNER_SHA256_X64" && test -n "$RUNNER_SHA256_ARM64" \
    && test -n "$GH_VERSION" && test -n "$GH_SHA256_X64" && test -n "$GH_SHA256_ARM64" \
    && test -n "$RUSTUP_VERSION" && test -n "$RUSTUP_SHA256_X64" && test -n "$RUSTUP_SHA256_ARM64" \
    && test -n "$RUSTUP_LICENSE_MIT_SHA256" && test -n "$RUSTUP_LICENSE_APACHE_SHA256" \
    && apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install --yes --no-install-recommends \
      build-essential ca-certificates curl docker-compose-v2 docker.io git jq php-cli python3 shellcheck unzip \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1001 --shell /bin/bash runner \
    && install -d -o runner -g runner /opt/actions-runner /runner \
    && case "$TARGETARCH" in \
         amd64) runner_arch=x64; runner_sha="$RUNNER_SHA256_X64"; gh_arch=amd64; gh_sha="$GH_SHA256_X64"; rustup_arch=x86_64; rustup_sha="$RUSTUP_SHA256_X64" ;; \
         arm64) runner_arch=arm64; runner_sha="$RUNNER_SHA256_ARM64"; gh_arch=arm64; gh_sha="$GH_SHA256_ARM64"; rustup_arch=aarch64; rustup_sha="$RUSTUP_SHA256_ARM64" ;; \
         *) exit 1 ;; \
       esac \
    && curl --fail --show-error --location --proto '=https' --tlsv1.2 \
      --output /tmp/actions-runner.tar.gz \
      "https://github.com/actions/runner/releases/download/v${RUNNER_VERSION}/actions-runner-linux-${runner_arch}-${RUNNER_VERSION}.tar.gz" \
    && echo "${runner_sha}  /tmp/actions-runner.tar.gz" | sha256sum --check --strict \
    && tar --extract --gzip --file /tmp/actions-runner.tar.gz --directory /opt/actions-runner \
    && rm /tmp/actions-runner.tar.gz \
    && curl --fail --show-error --location --proto '=https' --tlsv1.2 \
      --output /tmp/gh.tar.gz \
      "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_${gh_arch}.tar.gz" \
    && echo "${gh_sha}  /tmp/gh.tar.gz" | sha256sum --check --strict \
    && install -d /usr/share/doc/gh \
    && tar --extract --gzip --file /tmp/gh.tar.gz --directory /usr/local/bin \
      --strip-components=2 "gh_${GH_VERSION}_linux_${gh_arch}/bin/gh" \
    && tar --extract --gzip --file /tmp/gh.tar.gz --directory /usr/share/doc/gh \
      --strip-components=1 "gh_${GH_VERSION}_linux_${gh_arch}/LICENSE" \
    && chmod 0555 /usr/local/bin/gh \
    && chmod 0444 /usr/share/doc/gh/LICENSE \
    && rm /tmp/gh.tar.gz \
    && gh --version \
    && curl --fail --show-error --location --proto '=https' --tlsv1.2 \
      --output /tmp/rustup-init \
      "https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/${rustup_arch}-unknown-linux-gnu/rustup-init" \
    && echo "${rustup_sha}  /tmp/rustup-init" | sha256sum --check --strict \
    && install -o runner -g runner -m 0555 /tmp/rustup-init /home/runner/rustup-init \
    && rm /tmp/rustup-init \
    && install -d /usr/share/doc/rustup \
    && curl --fail --show-error --location --proto '=https' --tlsv1.2 \
      --output /usr/share/doc/rustup/LICENSE-MIT \
      "https://raw.githubusercontent.com/rust-lang/rustup/${RUSTUP_VERSION}/LICENSE-MIT" \
    && echo "${RUSTUP_LICENSE_MIT_SHA256}  /usr/share/doc/rustup/LICENSE-MIT" | sha256sum --check --strict \
    && curl --fail --show-error --location --proto '=https' --tlsv1.2 \
      --output /usr/share/doc/rustup/LICENSE-APACHE \
      "https://raw.githubusercontent.com/rust-lang/rustup/${RUSTUP_VERSION}/LICENSE-APACHE" \
    && echo "${RUSTUP_LICENSE_APACHE_SHA256}  /usr/share/doc/rustup/LICENSE-APACHE" | sha256sum --check --strict \
    && chmod 0444 /usr/share/doc/rustup/LICENSE-MIT /usr/share/doc/rustup/LICENSE-APACHE \
    && /opt/actions-runner/bin/installdependencies.sh \
    && chown -R runner:runner /opt/actions-runner /runner

COPY --chown=runner:runner runner-entrypoint.sh /usr/local/bin/jit-runner-entrypoint
RUN chmod 0555 /usr/local/bin/jit-runner-entrypoint

USER runner
ENV CARGO_HOME=/home/runner/.cargo \
    RUSTUP_HOME=/home/runner/.rustup \
    PATH=/home/runner/.cargo/bin:${PATH}
RUN /home/runner/rustup-init -y --profile minimal --default-toolchain none --no-modify-path \
    && rm /home/runner/rustup-init \
    && rustup --version
WORKDIR /runner
ENTRYPOINT ["/usr/local/bin/jit-runner-entrypoint"]
